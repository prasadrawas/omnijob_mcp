# =============================================================================
# OmniJob MCP Server Configuration (.env)
# Universal 7-in-1 Model Context Protocol Server
# Supports: Naukri, Hirist, Wellfound, Instahyre, Cutshort, Greenhouse, Foundit
# =============================================================================

# Transport & Server Configuration
PORT=8000
MCP_TRANSPORT=sse

# -----------------------------------------------------------------------------
# 1. NAUKRI (naukri.com)
# -----------------------------------------------------------------------------
NAUK_RT="your_nauk_rt_cookie"
NAUK_AT="your_nauk_at_token"
NAUKRI_PROFILE_ID=""

# -----------------------------------------------------------------------------
# 2. HIRIST (hirist.tech)
# -----------------------------------------------------------------------------
HIRIST_CK1="your_hirist_ck1_cookie"
PHPSESSID="your_phpsessid_cookie"

# -----------------------------------------------------------------------------
# 3. WELLFOUND (wellfound.com / AngelList)
# -----------------------------------------------------------------------------
WELLFOUND_COOKIE="your__wellfound_cookie"
CF_CLEARANCE="your_wellfound_cf_clearance"

# -----------------------------------------------------------------------------
# 4. INSTAHYRE (instahyre.com)
# -----------------------------------------------------------------------------
INSTAHYRE_SESSIONID="your_instahyre_sessionid"
INSTAHYRE_CSRFTOKEN="your_instahyre_csrftoken"
INSTAHYRE_CF_CLEARANCE="your_instahyre_cf_clearance"
INSTAHYRE_USER_AGENT="Mozilla/5.0 (Macintosh; Intel Mac OS X 10.15; rv:160.0) Gecko/20100101 Firefox/160.0"

# -----------------------------------------------------------------------------
# 5. CUTSHORT (cutshort.io)
# -----------------------------------------------------------------------------
CUTSHORT_AUTHENTICATION="s%3A..."
CUTSHORT_CF_CLEARANCE="your_cutshort_cf_clearance"
CUTSHORT_XSRF_TOKEN="your_cutshort_xsrf_token"
CUTSHORT_CSSID="your_cutshort_cssid"
CUTSHORT_USER_AGENT="Mozilla/5.0 (Macintosh; Intel Mac OS X 10.15; rv:160.0) Gecko/20100101 Firefox/160.0"

# -----------------------------------------------------------------------------
# 6. GREENHOUSE ATS (boards-api.greenhouse.io)
# -----------------------------------------------------------------------------
# Optional: Employer-issued Job Board API Key (enables multipart/form-data POST apply)
GREENHOUSE_API_KEY=""

# -----------------------------------------------------------------------------
# 7. FOUNDIT (foundit.in / Monster APAC)
# -----------------------------------------------------------------------------
FOUNDIT_MSSOAT="your_mssoat_token"
FOUNDIT_MSSOCLIENT="your_mssoclient_uuid"
FOUNDIT_MSAL="your_msal_cookie"
FOUNDIT_ABCK="your_foundit_abck"
FOUNDIT_BM_SZ="your_foundit_bm_sz"
FOUNDIT_BM_SV="your_foundit_bm_sv"
FOUNDIT_AK_BMSC="your_foundit_ak_bmsc"
